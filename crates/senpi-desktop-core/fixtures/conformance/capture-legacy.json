{
  "description": "a legacy-fallback capture reports legacyCapture: true on the capture result and a false/absent SCK capture reports it false.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/capture-legacy.json",
  "env": {},
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake"
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "capture",
        "params": {
          "target": "desktop"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "mode": "inline-png",
              "mimeType": "image/png",
              "target": "desktop",
              "legacyCapture": true
            }
          },
          "variable": [
            "/result/data",
            "/result/width",
            "/result/height",
            "/result/sourceWidth",
            "/result/sourceHeight",
            "/result/coordinateWidth",
            "/result/coordinateHeight",
            "/result/scale",
            "/result/frameId"
          ]
        }
      ]
    }
  ]
}
